# Required: a public DNS hostname, without https://, a path, or a port.
# Example: git.example.com
FORGEJO_DOMAIN=

# Required: email for the Let's Encrypt ACME account.
ACME_EMAIL=

# Required: generate a password with `openssl rand -hex 32`.
# Hex avoids Docker Compose interpolation/quoting surprises.
POSTGRES_PASSWORD=

# Administrator-created accounts by default. Set false for public signup
# only AFTER creating the first administrator as described in README.md.
DISABLE_REGISTRATION=true

# Default is Let's Encrypt production. Staging issues untrusted test certs.
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
